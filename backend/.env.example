# Database Configuration (Neon PostgreSQL Cloud Database)
# Replace user, password, ep-dummy-neon-host, and neondb with your actual Neon database credentials
DATABASE_URL=postgresql+asyncpg://user:password@ep-dummy-neon-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Secret Key
SECRET_KEY=change_this_in_production_to_a_secure_secret_key

# Debug Mode
DEBUG=True

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
